config("googletest_config") {
  defines = [ "GTEST_LANG_CXX17=1" ]
  include_dirs = [
    "googletest/include",
    "googlemock/include",
  ]
}

source_set("gtest") {
  testonly = true
  include_dirs = [ "googletest" ]
  public_configs = [ ":googletest_config" ]
  all_dependent_configs = [ ":googletest_config" ]
  sources = [ "googletest/src/gtest-all.cc" ]
}

source_set("gtest_main") {
  testonly = true
  configs += [ ":googletest_config" ]
  deps = [ ":gtest" ]
  sources = [ "googletest/src/gtest_main.cc" ]
}

source_set("gmock") {
  testonly = true
  include_dirs = [ "googlemock" ]
  public_configs = [ ":googletest_config" ]
  all_dependent_configs = [ ":googletest_config" ]
  sources = [
    "googlemock/src/gmock-cardinalities.cc",
    "googlemock/src/gmock-internal-utils.cc",
    "googlemock/src/gmock-matchers.cc",
    "googlemock/src/gmock-spec-builders.cc",
    "googlemock/src/gmock.cc",
  ]
}



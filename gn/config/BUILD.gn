config("compiler") {
  if (is_linux) {
    configs = [ "linux:compiler" ]
  }
}

config("suppressions") {
  cflags = [
    # The pattern of `if (error = foo()))` is common in the code base.
    "-Wno-parentheses",
    # The pattern of `::fooLog("Something %s", aCString);`
    # is the common in the code base.
    "-Wno-non-pod-varargs",

    "-Wno-inconsistent-missing-override",
    "-Wno-switch",
    "-Wno-pragma-pack",
    "-Wno-microsoft-cast",
    "-Wno-delayed-template-parsing-in-cxx20",
    "-Wno-return-type",
  ]
}

config("compiler_config") {
  configs = [
    ":suppressions",
    ":compiler",
    ":runtime_library",
  ]
  cflags = [
    #"-Wall",
    #"-Wextra",
    #"-Wpedantic",

    # TODO(chromy): enable -Werror
    #"-Werror",
    "-fcolor-diagnostics",
  ]

  if (is_win) {
    cflags += [
      "-fms-extensions",
      "-fms-compatibility-version=19",
      "-fdelayed-template-parsing",
    ]
  }

  cflags_cc = [ "-std=c++20" ]
  cflags_objcc = [ "-std=c++20" ]
}

config("debug_config") {
  ldflags = [ "-g" ]
  cflags = [
    "-g",
    "-O0",
  ]
}

config("release_config") {
  defines = [ "NDEBUG" ]
  cflags = [ "-O3" ]
}

config("executable_config") {
  ldflags = []
}

config("runtime_library") {
  cflags = []
  cflags_cc = [ "-nostdinc++" ]
  ldflags = [
    "-nostdlib",
    "-nostdlib++",
  ]

  if (is_win) {

    ldflags += [
      "-L" + rebase_path("//deps/windows/crt/lib/$current_cpu", root_build_dir),
      "-L" + rebase_path("//deps/windows/sdk/lib/um/$current_cpu", root_build_dir),
      "-L" + rebase_path("//deps/windows/sdk/lib/ucrt/$current_cpu", root_build_dir),
      "-lucrt",
      "-lvcruntime",
      "-lmsvcrt",
      "-lmsvcprt",
      "-lkernel32",
      "-luser32",

      "-lWS2_32",
      "-lversion",
      "-lvfw32",
      "-lwinmm",
      "-ldsound",
      "-lodbc32",
      "-lodbccp32",
      "-lshell32",

      # Uppercase .Lib suffix causes problems:
      #"-lGdi32",
      #"-lAdvapi32",
      rebase_path("//deps/windows/sdk/lib/um/$current_cpu/Gdi32.Lib", root_build_dir),
      rebase_path("//deps/windows/sdk/lib/um/$current_cpu/AdvAPI32.Lib", root_build_dir),

      "-fms-runtime-lib=dll",

      # Unclear if this is correct or not.
      "--for-linker=-safeseh:no",

      #"-llibucrt",
      #"-llibvcruntime",
      #"-llibcmt",
      #"-llibcpmt",

      #"-v",
    ]

    cflags += [
      "-fms-extensions",
      "-fms-compatibility",
      "-fms-runtime-lib=dll",

      "-isystem" + rebase_path("//deps/windows/crt/include", root_build_dir),
      "-isystem" + rebase_path("//deps/windows/sdk/include/ucrt", root_build_dir),
      "-isystem" + rebase_path("//deps/windows/sdk/include/shared", root_build_dir),
      "-isystem" + rebase_path("//deps/windows/sdk/include/winrt", root_build_dir),
      "-isystem" + rebase_path("//deps/windows/sdk/include/um", root_build_dir),

      #"-v",
    ]

    cflags_cc += [
    ]

  }

  #if (is_linux) {
  #  configs = [ "linux:runtime_library" ]
  #}
}

# Default optimisation level. Exactly one of:
# - debug_config
# - release_config
config("optimization_config") {
  if (is_debug) {
    configs = [ "//gn/config:debug_config" ]
  } else {
    configs = [ "//gn/config:release_config" ]
  }
}

# This group is a dependency of every executable and shared library.
group("common_deps") {
  visibility = [
    ":executable_deps",
    ":loadable_module_deps",
    ":shared_library_deps",
  ]
}

# Only the executable template in BUILDCONFIG.gn should reference this.
group("executable_deps") {
  public_deps = [ ":common_deps" ]
}

# Only the loadable_module template in BUILDCONFIG.gn should reference this.
group("loadable_module_deps") {
  public_deps = [ ":common_deps" ]
}

# Only the shared_library template in BUILDCONFIG.gn should reference this.
group("shared_library_deps") {
  public_deps = [ ":common_deps" ]
}

